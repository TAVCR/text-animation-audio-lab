{
  "name": "text-animation-app",
  "version": "0.1.4",
  "private": true,
  "main": "electron/main.cjs",
  "bin": {
    "text-animation": "bin/text-animation.cjs",
    "text-animation-mcp": "bin/text-animation-mcp.cjs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "desktop:package": "npm run build && electron-builder --win nsis",
    "start": "next start",
    "lint": "next lint",
    "test:editor": "vitest run tests/editor",
    "remotion:bundle": "remotion bundle src/remotion/index.ts",
    "remotion:render:main": "remotion render build Main",
    "remotion:render:main:quick": "npm run -s remotion:bundle && remotion render build Main tmp/previews/main-quick.mp4 --frames=0-89 --concurrency=8 --scale=0.75",
    "remotion:benchmark:main": "remotion benchmark build Main --runs=1 --concurrencies=8,16 --frames=0-119",
    "studio:exp": "remotion studio src/remotion/experimental/index.ts --port 3030 --force-new",
    "comps:exp": "remotion compositions src/remotion/experimental/index.ts"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "@remotion/bundler": "4.0.520",
    "@remotion/cli": "4.0.520",
    "@remotion/player": "4.0.520",
    "@remotion/renderer": "4.0.520",
    "@remotion/tailwind": "4.0.520",
    "@remotion/three": "4.0.520",
    "next": "14.2.15",
    "postprocessing": "^6.39.0",
    "re-resizable": "^6.11.2",
    "react": "^18",
    "react-dom": "^18",
    "react-draggable": "^4.5.0",
    "remotion": "4.0.520",
    "three": "^0.168.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "electron": "^35.7.5",
    "electron-builder": "^26.15.3",
    "eslint": "^8",
    "eslint-config-next": "14.2.15",
    "jsdom": "^24.1.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.antigravity.textanimation",
    "productName": "Text Animation",
    "directories": { "output": "release" },
    "files": ["electron/**/*", "package.json"],
    "extraResources": [
      { "from": ".next/standalone", "to": "server", "filter": ["**/*", "!public/**", "!public", "!src/**", "!src", "!tmp/**", "!tmp"] },
      { "from": ".next/standalone/node_modules", "to": "server/node_modules", "filter": ["**/*", "!**/.cache/**", "!**/.cache"] },
      { "from": "src", "to": "server/src" },
      { "from": ".next/static", "to": "server/.next/static" },
      { "from": "public", "to": "server/public", "filter": ["**/*", "!renders/**", "!renders", "!tmp/**", "!tmp"] }
    ],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
